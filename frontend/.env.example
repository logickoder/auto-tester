# Copy to .env.local and fill in. Leave the Supabase values empty to run in
# dev mode (login is skipped). See docs/SETUP.md, steps 2-3.

# Supabase -> Project Settings -> API: Project URL and the anon "public" key.
# Never put the service_role key here; everything NEXT_PUBLIC_* reaches the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the FastAPI backend runs; the /api/backend proxy forwards to it.
# Production: https://api.tester.zedu.chat (the dashboard itself is https://tester.zedu.chat)
FASTAPI_BASE_URL=http://localhost:8000

# Public API URL shown in the Connect project setup snippet (runner config).
# Empty = https://api.tester.zedu.chat
NEXT_PUBLIC_AUTOTESTER_API_URL=
