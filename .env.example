# Port the FastAPI service listens on (Coolify sets this too).
PORT=8000

# --- Supabase (leave empty to run in local dev mode with an in-memory store) ---
# Project Settings -> Data API / API Keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: verify dashboard logins locally instead of calling Supabase
# (Project Settings -> Auth -> JWT secret)
SUPABASE_JWT_SECRET=

# Comma-separated origins allowed to call the API directly (the Next.js
# frontend normally proxies through /api/backend, so this can stay as-is).
AUTOTESTER_CORS_ORIGINS=http://localhost:3000

# Evidence (failure screenshots) retention: files are kept under ./evidence
# in dev mode; in Supabase mode they live in the private "evidence" bucket.
EVIDENCE_DIR=evidence


# --- Auto Tester features ---
# Public dashboard URL, used for links in alerts (FR-24)
DASHBOARD_URL=http://localhost:3000
# NFR Safety: hosts a project's staging URL may use. Leave empty locally.
STAGING_ALLOWLIST=staging.zedu.chat
# Who may log in. Leave both empty locally; set at least one in production.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=
# FR-24 alerts: incoming-webhook URL of the Zedu channel (or Slack-compatible). Empty = off.
ALERT_WEBHOOK_URL=
ALERT_ON_SUCCESS=false
# FR-14 re-run: fine-grained PAT with Actions: write on the runner repo
GITHUB_TOKEN=
RUNNER_REPO=zedu-yodaa/auto-tester
RUNNER_REF=main
RUNNER_WORKFLOW_FILE=smoke.yml
